  "components": {
    "schemas": {
      "AnnualExpenseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "totalAmount": {
            "type": "number",
            "format": "double"
          },
          "priority": {
            "type": "string",
            "nullable": true
          },
          "expectedMonth": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AppleLoginDto": {
        "type": "object",
        "properties": {
          "identityToken": {
            "type": "string",
            "nullable": true
          },
          "fullName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateExpenseDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "DebtDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "monthlyAmount": {
            "type": "number",
            "format": "double"
          },
          "priority": {
            "type": "string",
            "nullable": true
          },
          "dueDate": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FixedExpensesDto": {
        "type": "object",
        "properties": {
          "rent": {
            "type": "number",
            "format": "double"
          },
          "electricity": {
            "type": "number",
            "format": "double"
          },
          "water": {
            "type": "number",
            "format": "double"
          },
          "gas": {
            "type": "number",
            "format": "double"
          },
          "transportation": {
            "type": "number",
            "format": "double"
          },
          "internet": {
            "type": "number",
            "format": "double"
          },
          "mobile": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ForgotPasswordDto": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false
      },
      "GoogleLoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LogPurchaseItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "cost": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "LogPurchasesRequest": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogPurchaseItemDto"
            },
            "nullable": true
          }
        },
